@{
    ViewData["Title"] = "พัฒนาทักษะของคุณ";
    var recommendedCourses = new[]
    {
        (Name: "Graphic Design", Image: "Graphic Design.jpg"),
        (Name: "3D & Animation", Image: "3D & Animation.jpg"),
        (Name: "Video Editing", Image: "Video Editing.jpg"),
        (Name: "UX/UI", Image: "UX UI.jpg"),
        (Name: "Digital Marketing", Image: "Digital Marketing.jpg")
    };
}

<div class="framework-page home-framework">
    <section class="framework-hero">
        <div class="framework-hero-copy"><h1>พัฒนาทักษะของคุณ<br />ก้าวไปสู่โอกาสใหม่</h1><div class="quiz-prompt"><b>ไม่รู้จะเริ่มเรียนอะไร</b><small>ลองทำแบบประเมิน 1 นาทีเพื่อค้นหาทักษะที่ใช่</small></div><a class="framework-quiz-button" href="@(User.Identity?.IsAuthenticated == true ? Url.Action("Quiz", "Home") : Url.Action("Login", "Home"))">Take Skill Quiz</a></div>
        <div class="framework-placeholder hero-placeholder"><img class="home-hero-image" src="@Url.Content("~/Homepic.png")" asp-append-version="true" alt="ผู้เรียนกำลังพัฒนาทักษะ" /></div>
    </section>
    <style>
        .home-skill-categories { margin: 28px 0 34px; padding: 8px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); background: #fff; border: 1px solid #e8eaf2; border-radius: 20px; box-shadow: 0 14px 35px rgba(79,70,229,.08); overflow: hidden; pointer-events: none; cursor: default; }
        .home-skill-category { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 18px 10px 16px; color: #172033; text-align: center; border-right: 1px solid #eef0f5; }
        .home-skill-category:last-child { border-right: 0; }
        .home-skill-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px; color: #4f46e5; background: #eef2ff; }
        .home-skill-icon svg { width: 21px; height: 21px; }
        .home-skill-category:nth-child(2) .home-skill-icon { color: #0891b2; background: #ecfeff; }
        .home-skill-category:nth-child(3) .home-skill-icon { color: #db2777; background: #fce7f3; }
        .home-skill-category:nth-child(4) .home-skill-icon { color: #16a34a; background: #dcfce7; }
        .home-skill-category:nth-child(5) .home-skill-icon { color: #d97706; background: #fef3c7; }
        .home-skill-category:nth-child(6) .home-skill-icon { color: #7c3aed; background: #f3e8ff; }
        .home-skill-category strong { font-size: .82rem; line-height: 1.25; }
        .home-skill-category small { padding: 4px 9px; color: #596579; background: #f1f5f9; border-radius: 99px; font-size: .64rem; white-space: nowrap; }
        .dark-theme .home-skill-categories { background: #111827; border-color: #263244; box-shadow: 0 14px 35px rgba(0,0,0,.2); }
        .dark-theme .home-skill-category { color: #e5e7eb; border-color: #263244; }
        .dark-theme .home-skill-category small { color: #cbd5e1; background: #1e293b; }
        html.dark-theme .home-framework .framework-quiz-button { border: 1px solid #a5b4fc !important; background: linear-gradient(135deg, #6366f1, #4f46e5) !important; color: #ffffff !important; box-shadow: 0 8px 20px rgba(99, 102, 241, .38) !important; }
        html.dark-theme .home-framework .framework-quiz-button:hover { background: linear-gradient(135deg, #818cf8, #6366f1) !important; color: #ffffff !important; box-shadow: 0 12px 26px rgba(129, 140, 248, .48) !important; }
        @@media (max-width: 900px) { .home-skill-categories { grid-template-columns: repeat(3, 1fr); } .home-skill-category:nth-child(3) { border-right: 0; } .home-skill-category:nth-child(-n+3) { border-bottom: 1px solid #eef0f5; } .dark-theme .home-skill-category:nth-child(-n+3) { border-color: #263244; } }
        @@media (max-width: 520px) { .home-skill-categories { grid-template-columns: repeat(2, 1fr); } .home-skill-category:nth-child(2n) { border-right: 0; } .home-skill-category:nth-child(3) { border-right: 1px solid #eef0f5; } .home-skill-category:nth-child(-n+3) { border-bottom: 0; } .home-skill-category:nth-child(-n+4) { border-bottom: 1px solid #eef0f5; } .dark-theme .home-skill-category:nth-child(3) { border-color: #263244; } }
    </style>
    <section class="home-skill-categories" aria-label="หมวดหมู่ทักษะ">
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2L12 3Z"/><path d="m19 3 .5 1.5L21 5l-1.5.5L19 7l-.5-1.5L17 5l1.5-.5L19 3Z"/></svg></span><strong>Graphic Design</strong><small>Project-Based</small></div>
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg></span><strong>3D &amp; Animation</strong><small>Project-Based</small></div>
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3V9Z"/></svg></span><strong>Video Editing</strong><small>Micro-learning</small></div>
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v12H4z"/><path d="M8 21h8M12 17v4M8 9h8M8 12h5"/></svg></span><strong>UX/UI</strong><small>Micro-learning</small></div>
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 5 8-2 8 2v14l-8 2-8-2V5Z"/><path d="m4 5 8 2 8-2M12 7v14"/></svg></span><strong>Web Development</strong><small>Project-Based</small></div>
        <div class="home-skill-category"><span class="home-skill-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m6 16 4-5 3 3 5-7"/><path d="M15 7h3v3"/></svg></span><strong>Digital Marketing</strong><small>Micro-learning</small></div>
    </section>
    <section class="framework-courses" id="courses"><div class="framework-course-list"><h2>คอร์สแนะนำสำหรับคุณ</h2><div class="framework-course-grid">@foreach (var course in recommendedCourses) { <a class="framework-course-card" asp-controller="Home" asp-action="Category" asp-route-skill="@course.Name"><div class="framework-placeholder course-topic-image"><img src="@Url.Content("~/" + course.Image)" asp-append-version="true" alt="รูป @course.Name" loading="lazy" /></div><h3>@course.Name</h3></a> }</div></div><partial name="_UserSidebar" /></section>
</div>
