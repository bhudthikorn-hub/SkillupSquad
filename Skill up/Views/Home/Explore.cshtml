@{
    ViewData["Title"] = "Explore Skills";
    var skills = new[]
    {
        (Name: "Graphic Design", Image: "Graphic Design.jpg", Description: "ออกแบบภาพ โลโก้ และสื่อให้สวยและสื่อสารได้ตรงกลุ่มเป้าหมาย"),
        (Name: "3D & Animation", Image: "3D & Animation.jpg", Description: "สร้างโมเดล 3D ใส่แสง วัสดุ และแอนิเมชันสำหรับงานจริง"),
        (Name: "Video Editing", Image: "Video Editing.jpg", Description: "ตัดต่อวิดีโอ เล่าเรื่อง และสร้างคอนเทนต์ให้น่าสนใจ"),
        (Name: "UX/UI", Image: "UX UI.jpg", Description: "ออกแบบหน้าจอและประสบการณ์ใช้งานให้สวยและใช้งานง่าย"),
        (Name: "Web Development", Image: "Web Development.jpg", Description: "เรียนรู้การสร้างเว็บไซต์ตั้งแต่พื้นฐานจนใช้งานได้จริง"),
        (Name: "Digital Marketing", Image: "Digital Marketing.jpg", Description: "วางแผนคอนเทนต์และการตลาดออนไลน์ให้เข้าถึงกลุ่มเป้าหมาย")
    };
}
<style>
    .framework-explore-grid .framework-skill-card {
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .framework-explore-grid .framework-skill-card .explore-skill-image {
        display: block;
        width: 100%;
        height: 180px;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .framework-explore-grid .framework-skill-card .explore-skill-image img {
        display: block;
        width: 100%;
        height: 180px;
        margin: 0;
        padding: 0;
        object-fit: cover;
        object-position: center;
    }

    .framework-explore-grid .framework-skill-card .explore-skill-name,
    .framework-explore-grid .framework-skill-card > p {
        display: block;
        margin-left: 0;
        margin-right: 0;
        padding: 16px 20px 0;
    }

    .framework-explore-grid .framework-skill-card > p {
        padding-top: 8px;
        padding-bottom: 20px;
    }
</style>
<div class="framework-page explore-framework">
    <div class="framework-breadcrumb">Home / Explore Skills</div>
    <div class="framework-content-columns">
        <main class="framework-explore-main"><h1>Explore Skills</h1><p class="framework-subtitle">ค้นหาทักษะที่ใช่</p><div class="framework-explore-grid">@foreach (var skill in skills) { <a class="framework-skill-card" asp-controller="Home" asp-action="Category" asp-route-skill="@skill.Name"><span class="explore-skill-image">@if (!string.IsNullOrWhiteSpace(skill.Image)) { <img src="@Url.Content("~/" + skill.Image)" asp-append-version="true" alt="รูป @skill.Name" loading="lazy" /> }</span><span class="explore-skill-name">@skill.Name</span><p>@skill.Description</p></a> }</div></main>
        <partial name="_UserSidebar" />
    </div>
</div>