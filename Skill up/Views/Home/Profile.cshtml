@model Skill_up.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="framework-page profile-framework">
    <div class="framework-breadcrumb">Home / Profile</div>
    <div class="framework-content-columns">
        <main class="framework-profile-main">
            <div class="profile-heading-row"><div><span class="profile-eyebrow">SKILLUP DASHBOARD</span><h1>My Profile</h1><p>ติดตามการเรียนรู้และความสำเร็จของคุณในที่เดียว</p></div></div>
            <div class="profile-framework-top">
                <section class="profile-framework-card profile-identity-card">
                    <div class="profile-avatar-large">@(!string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.DisplayName.Trim().Substring(0, 1) : Model.AvatarLetter)</div>
                    <div class="profile-identity-copy"><b>@Model.DisplayName</b><small>@Model.Email</small><span class="profile-member-badge">✦ สมาชิก SkillUp</span></div>
                </section>
                <section class="profile-framework-card profile-summary-card">
                    <div class="profile-summary-header"><div><span class="profile-card-kicker">LEARNING OVERVIEW</span><h2>สรุปการเรียน</h2></div><span class="profile-summary-icon">↗</span></div>
                    <div class="profile-stat-grid">
                        <div><strong>@Model.Skills.Count</strong><small>คอร์สทั้งหมด</small></div>
                        <div><strong>@Model.CompletedCourseCount</strong><small>เรียนจบแล้ว</small></div>
                        <div><strong>@Model.AverageProgress%</strong><small>ความก้าวหน้าเฉลี่ย</small></div>
                    </div>
                </section>
            </div>
            <section class="profile-framework-section profile-current-skills"><div class="profile-section-heading"><div><span class="profile-card-kicker">YOUR FOCUS</span><h2>ทักษะของฉัน</h2></div><span class="profile-section-count">@Model.Skills.Count ทักษะ</span></div><div class="profile-skills-grid">
                @if (Model.Skills.Count == 0)
                {
                    <p>เริ่มเพิ่มคอร์สจากหน้า Explore เพื่อดูทักษะและความก้าวหน้าของคุณ</p>
                }
                else
                {
                    @foreach (var skill in Model.Skills)
                    {
                        var skillIcon = skill.Category switch
                        {
                            "Graphic Design" => "🎨",
                            "Web Development" => "&lt;/&gt;",
                            "Digital Marketing" => "📈",
                            "Video Editing" => "▶",
                            "UX/UI" => "✦",
                            "3D & Animation" => "◇",
                            _ => "✦"
                        };
                        <div class="profile-skill-pill @(skill.ProgressPercent >= 100 ? "is-complete" : "is-learning")"><span class="profile-skill-icon">@Html.Raw(skillIcon)</span><span class="profile-skill-name">@skill.Name</span><span class="profile-skill-status">@(skill.ProgressPercent >= 100 ? "เสร็จแล้ว" : "กำลังเรียน")</span></div>
                    }
                }
            </div></section>
            <section class="profile-framework-section profile-progress-section"><div class="profile-section-heading"><h2>ความก้าวหน้าทักษะ</h2></div><div class="profile-progress-grid">
                @if (Model.Skills.Count == 0)
                {
                    <p>ยังไม่มีข้อมูลความก้าวหน้า</p>
                }
                else
                {
                    @foreach (var skill in Model.Skills)
                    {
                        <div class="progress-skill-card"><div class="progress-skill-info"><div><b>@skill.Name</b></div><a asp-controller="Home" asp-action="CourseLearning" asp-route-skill="@skill.Name">ไปเรียนต่อ <span>→</span></a><div class="profile-progress-bar"><i style="width:@skill.ProgressPercent% !important"></i></div></div><strong>@skill.ProgressPercent%</strong></div>
                    }
                }
            </div></section>
            <section class="profile-framework-section profile-achievements-section"><div class="profile-section-heading"><div><span class="profile-card-kicker">MILESTONES</span><h2>เหรียญรางวัลและความสำเร็จ</h2></div><span class="profile-section-count">@Model.Skills.Count เหรียญ</span></div><div class="profile-achievements-grid">
                @if (Model.Skills.Count == 0)
                {
                    <p class="profile-empty-achievement">เริ่มเรียนคอร์สแรกเพื่อปลดล็อกเหรียญรางวัลของคุณ</p>
                }
                else
                {
                    @foreach (var skill in Model.Skills)
                    {
                        var completed = skill.ProgressPercent >= 100;
                        <div class="achievement-card @(completed ? "is-unlocked" : "is-locked")"><div class="achievement-medal">@(completed ? "★" : "◇")</div><div><b>@(completed ? "Completed Master" : "กำลังดำเนินการ")</b><span>@skill.Name</span></div><small>@(completed ? "ปลดล็อกแล้ว" : $"เรียนไปแล้ว {skill.ProgressPercent}%")</small></div>
                    }
                }
            </div></section>
        </main>
        <partial name="_UserSidebar" />
    </div>
</div>

<style>
