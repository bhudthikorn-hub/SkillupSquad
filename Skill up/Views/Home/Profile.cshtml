    .progress-skill-info a:hover { color: #4338ca; }
    .progress-skill-card > strong { color: #4f46e5; font-size: 18px; }
    .achievement-card { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 13px; padding: 18px; border: 1px solid #e2e8f0; border-radius: 18px; }
    .achievement-medal { display: grid; width: 52px; height: 52px; place-items: center; border-radius: 16px; color: #fff; background: #cbd5e1; font-size: 27px; }
    .achievement-card > div:nth-child(2) { display: grid; gap: 3px; min-width: 0; }
    .achievement-card b { color: #1e293b; font-size: 14px; }
    .achievement-card span, .achievement-card > small { color: #64748b; font-size: 11px; }
    .achievement-card > small { grid-column: 2; }
    .achievement-card.is-unlocked { border-color: #ddd6fe; background: linear-gradient(135deg, #faf5ff, #fff); }
    .achievement-card.is-unlocked .achievement-medal { background: linear-gradient(135deg, #f59e0b, #7c3aed); box-shadow: 0 8px 18px rgba(124, 58, 237, .25); }
    .profile-empty-achievement { color: #64748b; }
    body.dark-mode .profile-framework-card, body.dark-mode .profile-framework-section, body.dark-mode .progress-skill-card, body.dark-mode .achievement-card, html.dark-theme .profile-framework-card, html.dark-theme .profile-framework-section, html.dark-theme .progress-skill-card, html.dark-theme .achievement-card { border-color: #334155; color: #f8fafc; background: #1e293b; }
    body.dark-mode .profile-heading-row p, body.dark-mode .profile-identity-copy small, body.dark-mode .profile-stat-grid small, body.dark-mode .progress-skill-info small, body.dark-mode .achievement-card span, body.dark-mode .achievement-card > small, html.dark-theme .profile-heading-row p, html.dark-theme .profile-identity-copy small, html.dark-theme .profile-stat-grid small, html.dark-theme .progress-skill-info small, html.dark-theme .achievement-card span, html.dark-theme .achievement-card > small { color: #cbd5e1; }
    body.dark-mode .profile-summary-header h2, body.dark-mode .profile-section-heading h2, body.dark-mode .profile-identity-copy b, body.dark-mode .progress-skill-info b, body.dark-mode .achievement-card b, html.dark-theme .profile-summary-header h2, html.dark-theme .profile-section-heading h2, html.dark-theme .profile-identity-copy b, html.dark-theme .progress-skill-info b, html.dark-theme .achievement-card b { color: #f8fafc; }
