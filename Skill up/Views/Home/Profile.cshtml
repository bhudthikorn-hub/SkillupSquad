    .profile-skills-grid { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 12px; margin-top: 20px; }
    .profile-skill-pill { display: inline-flex; width: fit-content; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid #c7d2fe; border-radius: 999px; color: #4338ca; background: #eef2ff; font-size: 13px; }
