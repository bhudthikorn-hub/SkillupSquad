    body.dark-mode .profile-level-track, body.dark-mode .profile-progress-bar, html.dark-theme .profile-level-track, html.dark-theme .profile-progress-bar { background: #334155; }
    body.dark-mode .profile-skill-pill, html.dark-theme .profile-skill-pill { border-color: #4c1d95; background: #2e1065; color: #ddd6fe; }
