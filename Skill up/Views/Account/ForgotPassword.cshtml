@model Skill_up.Controllers.AccountController.ForgotPasswordRequest
@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
    ViewData["HideThemeToggle"] = true;
    ViewData["HideTopbar"] = true;
    Layout = "_Layout";
}

<div class="login-page auth-page">
    <div class="login-brand">SkillUp</div>
    <div class="login-card password-reset-card">
        <section class="login-form-panel">
            <h2>เปลี่ยนรหัสผ่าน</h2>
            <p class="login-subtitle">กรอกชื่อผู้ใช้หรืออีเมล แล้วตั้งรหัสผ่านใหม่</p>
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="login-error"></div>
                <label>ชื่อผู้ใช้หรืออีเมล
                    <input asp-for="Username" placeholder="username หรือ yourname@email.com" autocomplete="username" />
                </label>
                <span asp-validation-for="Username" class="login-error"></span>
                <label>รหัสผ่านใหม่
                    <input asp-for="NewPassword" type="password" placeholder="อย่างน้อย 8 ตัวอักษร" autocomplete="new-password" />
                </label>
                <span asp-validation-for="NewPassword" class="login-error"></span>
                <label>ยืนยันรหัสผ่านใหม่
                    <input asp-for="ConfirmPassword" type="password" placeholder="กรอกรหัสผ่านอีกครั้ง" autocomplete="new-password" />
                </label>
                <span asp-validation-for="ConfirmPassword" class="login-error"></span>
                <button type="submit" class="button submit-button">เปลี่ยนรหัสผ่าน&nbsp; →</button>
            </form>
            <p class="signup-prompt"><a asp-controller="Home" asp-action="Login">← กลับไปหน้าเข้าสู่ระบบ</a></p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}