@inject UserManager<ApplicationUser> UserManager
@using Microsoft.AspNetCore.Http
@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var accountName = currentUser?.DisplayName;
    if (string.IsNullOrWhiteSpace(accountName))
    {
        accountName = currentUser?.UserName ?? User.Identity?.Name ?? "User";
    }
    var avatarLetter = accountName.Trim()[0].ToString().ToUpperInvariant();
    var isAdmin = string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillUp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/learning.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideTopbar"] as bool? != true)
    {
    <header class="topbar framework-topbar">
        <div class="topbar-inner">
            <a class="brand framework-brand" asp-controller="Home" asp-action="Index">SkillUp</a>
            <button class="mobile-menu" type="button" aria-label="เปิดเมนู" data-menu-toggle>☰</button>
            <nav class="main-nav" data-menu>
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@((ViewContext.RouteData.Values["action"]?.ToString() == "Explore" || ViewContext.RouteData.Values["action"]?.ToString() == "Category") ? "active" : "")" asp-controller="Home" asp-action="Explore">Explore Skills</a>
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Learning" ? "active" : "")" asp-controller="Home" asp-action="Learning">My Learning</a>
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile">Profile</a>
                @if (isAdmin)
                {
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Users">Admin Users</a>
                }
            </nav>
            <div class="header-actions">
                <label class="search-box framework-search"><span>⌕</span><input type="search" data-site-search autocomplete="off" placeholder="ค้นหาคอร์สเรียน" aria-label="ค้นหาคอร์สเรียน" /><div class="search-results" data-search-results></div></label>
                @if (ViewData["HideThemeToggle"] as bool? != true)
                {
                    <button class="theme-toggle" type="button" aria-label="เปลี่ยนธีม" data-theme-toggle><span>☀</span></button>
                }
                @if (currentUser is not null)
                {
                    <details class="profile-header-menu">
                        <summary class="profile-header-link" aria-label="เปิดเมนูบัญชีของ @accountName">
                            <span class="profile-header-avatar">@avatarLetter</span>
                            <span class="profile-header-name">@accountName</span>
                        </summary>
                        <div class="profile-dropdown">
                            <a asp-controller="Account" asp-action="Login">สลับบัญชี</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">ออกจากระบบ</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="auth-button login-link" asp-controller="Home" asp-action="Login">Login&nbsp; →</a>
                    <a class="auth-button signup-link" asp-controller="Account" asp-action="Register">Sign up&nbsp; →</a>
                }
            </div>
        </div>
    </header>
    }
    <main role="main">
            @RenderBody()
    </main>
    <div class="remove-course-modal" data-remove-course-modal hidden>
        <div class="remove-course-backdrop" data-remove-course-cancel></div>
        <section class="remove-course-dialog" role="dialog" aria-modal="true" aria-labelledby="remove-course-title">
            <button type="button" class="remove-course-close" data-remove-course-cancel aria-label="ปิด">×</button>
            <div class="remove-course-icon">!</div>
            <h2 id="remove-course-title">ยืนยันการลบคอร์ส</h2>
            <p>ต้องการลบ <strong data-remove-course-name>คอร์สนี้</strong> ออกจากรายการเรียนรู้หรือไม่?</p>
            <div class="remove-course-actions">
                <button type="button" class="remove-course-cancel" data-remove-course-cancel>ยกเลิก</button>
                <button type="button" class="remove-course-confirm" data-remove-course-confirm>ลบคอร์ส</button>
            </div>
        </section>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const svgNamespace = 'http://www.w3.org/2000/svg';
            const iconPaths = {
                edit: '<rect x="5" y="3" width="10" height="14" rx="1"/><path d="M8 3V1h4v2M8 8h4M8 11h4M8 14h2"/>',
                compass: '<circle cx="12" cy="12" r="8"/><path d="m14.8 9.2-2.1 3.5-3.5 2.1 2.1-3.5 3.5-2.1Z"/>',
                layers: '<path d="m12 3 8 4-8 4-8-4 8-4Z"/><path d="m4 12 8 4 8-4M4 16l8 4 8-4"/>',
                cube: '<path d="m12 2 8 4.5v9L12 20l-8-4.5v-9L12 2Z"/><path d="M4 6.5 12 11l8-4.5M12 11v9"/>',
                badge: '<circle cx="12" cy="12" r="8.5"/><path d="m8 12 2.5 2.5L16 9"/>'
            };

            const createIcon = (type) => {
                const svg = document.createElementNS(svgNamespace, 'svg');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.setAttribute('width', '16');
                svg.setAttribute('height', '16');
                svg.setAttribute('fill', 'none');
                svg.setAttribute('stroke', 'currentColor');
                svg.setAttribute('stroke-width', '1.8');
                svg.setAttribute('stroke-linecap', 'round');
                svg.setAttribute('stroke-linejoin', 'round');
                svg.setAttribute('aria-hidden', 'true');
                svg.innerHTML = iconPaths[type] || iconPaths.badge;
                return svg;
            };

            const getIconType = (element) => {
                let current = element;
                for (let depth = 0; current && depth < 3; depth++, current = current.parentElement) {
                    const context = current.textContent || '';
                    if (/ฝึกทำ|แบบฝึกหัด/i.test(context)) return 'edit';
                    if (/สมาชิก|แนะนำสำหรับคุณ|Roadmap/i.test(context)) return 'compass';
                    if (/UX\/UI|Graphic Design/i.test(context)) return 'layers';
                    if (/3D|Animation/i.test(context)) return 'cube';
                }
                return 'badge';
            };

            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
            const textNodes = [];
            let node;
            while (node = walker.nextNode()) {
                if (/✦|✧/.test(node.nodeValue) && !node.parentElement.closest('script, style, textarea, input')) {
                    textNodes.push(node);
                }
            }

            textNodes.forEach((textNode) => {
                const fragment = document.createDocumentFragment();
                const parts = textNode.nodeValue.split(/(✦|✧)/);
                parts.forEach((part) => {
                    if (part === '✦' || part === '✧') {
                        fragment.appendChild(createIcon(getIconType(textNode.parentElement)));
                    } else if (part) {
                        fragment.appendChild(document.createTextNode(part));
                    }
                });
                textNode.parentNode.replaceChild(fragment, textNode);
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const recommendationItems = document.querySelectorAll('.explore-recommendations > a');
            if (!recommendationItems.length) return;

            const addHoverEffect = (item) => {
                item.style.cursor = 'pointer';
                item.style.transition = 'all 0.2s ease';
                item.addEventListener('mouseenter', () => {
                    item.style.transform = 'translateX(4px)';
                    item.style.filter = 'brightness(1.06)';
                });
                item.addEventListener('mouseleave', () => {
                    item.style.transform = '';
                    item.style.filter = '';
                });
            };

            recommendationItems.forEach(addHoverEffect);
            if (recommendationItems[0]) {
                recommendationItems[0].href = '/Home/Category?skill=3D%20%26%20Animation';
            }
            if (recommendationItems[1]) {
                recommendationItems[1].href = '/Home/Explore';
            }

            const portfolioItem = recommendationItems[2];
            if (!portfolioItem) return;

            const openPortfolioModal = (event) => {
                event.preventDefault();
                let modal = document.querySelector('[data-portfolio-modal]');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.dataset.portfolioModal = '';
                    modal.innerHTML = `
                        <div data-portfolio-close></div>
                        <section role="dialog" aria-modal="true" aria-labelledby="portfolio-modal-title">
                            <button type="button" data-portfolio-close aria-label="ปิด">×</button>
                            <span>✦</span>
                            <h2 id="portfolio-modal-title">เทคนิคสร้างพอร์ตโฟลิโอ</h2>
                            <p>4 เทคนิคง่าย ๆ ที่ช่วยให้พอร์ตของคุณดูเป็นมืออาชีพและน่าสนใจ</p>
                            <ol>
                                <li><b>เลือกผลงานเด่น</b><small>คัดเฉพาะงานที่สะท้อนทักษะและสไตล์ของคุณ</small></li>
                                <li><b>เล่าเบื้องหลังกระบวนการ</b><small>แสดงแนวคิด ขั้นตอน และเหตุผลในการออกแบบ</small></li>
                                <li><b>จัดหมวดหมู่ให้ชัดเจน</b><small>แบ่งประเภทผลงานเพื่อให้ผู้ชมค้นหาได้ง่าย</small></li>
                                <li><b>อัปเดตข้อมูลเสมอ</b><small>เพิ่มผลงานใหม่และช่องทางติดต่อให้เป็นปัจจุบัน</small></li>
                            </ol>
                            <button type="button" data-portfolio-close>ปิดหน้าต่าง</button>
                        </section>`;
                    Object.assign(modal.style, {
                        position: 'fixed', inset: '0', zIndex: '1000', display: 'grid',
                        placeItems: 'center', padding: '20px', background: 'rgba(15, 23, 42, .62)'
                    });
                    const dialog = modal.querySelector('section');
                    const darkMode = () => document.documentElement.classList.contains('dark-theme') || document.body.classList.contains('dark-mode');
                    Object.assign(dialog.style, {
                        position: 'relative', width: 'min(100%, 520px)', padding: '30px',
                        border: '1px solid ' + (darkMode() ? '#475569' : '#dbe4f2'),
                        borderRadius: '22px', background: darkMode() ? '#1e293b' : '#ffffff',
                        color: darkMode() ? '#f8fafc' : '#172554', boxShadow: '0 24px 70px rgba(2, 6, 23, .3)'
                    });
                    Object.assign(modal.firstElementChild.style, { position: 'absolute', inset: '0', cursor: 'pointer' });
                    const dialogClose = dialog.querySelector('button[aria-label="ปิด"]');
                    dialogClose.style.cssText = 'position:absolute;top:14px;right:16px;border:0;background:transparent;color:inherit;font-size:26px;line-height:1;cursor:pointer;';
                    dialog.querySelector('span').style.cssText = 'display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#eef2ff;color:#4f46e5;font-size:22px;';
                    dialog.querySelector('h2').style.cssText = 'margin:14px 0 8px;font-size:24px;';
                    dialog.querySelector('p').style.cssText = 'margin:0 0 18px;color:' + (darkMode() ? '#cbd5e1' : '#64748b') + ';line-height:1.7;';
                    dialog.querySelector('ol').style.cssText = 'display:grid;gap:12px;margin:0;padding-left:22px;';
                    dialog.querySelectorAll('li').forEach((item) => {
                        item.style.cssText = 'padding:10px 12px;border-radius:12px;background:' + (darkMode() ? '#334155' : '#f8fafc') + ';line-height:1.45;';
                        item.querySelector('small').style.cssText = 'display:block;margin-top:3px;color:' + (darkMode() ? '#cbd5e1' : '#64748b') + ';';
                    });
                    const closeButton = dialog.querySelector('button:last-child');
                    closeButton.style.cssText = 'display:block;margin:22px 0 0 auto;padding:10px 16px;border:0;border-radius:10px;background:#4f46e5;color:#fff;font-weight:700;cursor:pointer;';
                    document.body.appendChild(modal);
                    modal.querySelectorAll('[data-portfolio-close]').forEach((button) => button.addEventListener('click', () => modal.remove()));
                    document.addEventListener('keydown', (keyEvent) => {
                        if (keyEvent.key === 'Escape' && document.body.contains(modal)) modal.remove();
                    }, { once: true });
                }
            };
            portfolioItem.addEventListener('click', openPortfolioModal);
        });
    </script>
</body>
</html>
