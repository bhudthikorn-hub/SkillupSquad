@model IReadOnlyList<AdminQuizViewModel>
@{ ViewData["Title"] = "Quiz & Assessment"; Layout = "_AdminLayout"; var search = ViewData["Search"] as string; var publishedQuizzes = Model.Count(quiz => quiz.Status == "Published"); var totalAttempts = Model.Sum(quiz => quiz.Attempts); var passedAttempts = Model.Sum(quiz => quiz.PassedAttempts); var averagePassRate = totalAttempts == 0 ? "—" : $"{(int)Math.Round(passedAttempts * 100d / totalAttempts)}%"; var pendingReview = 0; }
<div class="admin-page-heading"><h1>Quiz &amp; Assessment</h1></div>
<div class="admin-stat-grid"><div class="admin-stat-card"><span>Total Quizzes</span><b>@Model.Count</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></i></div><div class="admin-stat-card"><span>Active Assessments</span><b>@publishedQuizzes</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg></i></div><div class="admin-stat-card"><span>Avg. Pass Rate</span><b>@averagePassRate</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></i></div><div class="admin-stat-card"><span>Pending Review</span><b>@pendingReview</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i></div></div>
<section class="admin-list-section"><div class="admin-toolbar"><form class="table-search" method="get"><span>⌕</span><input name="search" value="@search" placeholder="Search assessments or courses" /><button class="admin-primary-button" type="submit">Search</button></form></div>
<table class="admin-table"><thead><tr><th>Assessment Name</th><th>Course Name</th><th>Category</th><th>Pass Rate</th><th>Attempts</th><th>Status</th></tr></thead><tbody>@foreach (var quiz in Model) { <tr data-admin-result data-admin-kind="quiz" data-admin-label="@quiz.Name" data-admin-url="/Admin/Quizzes"><td><strong>@quiz.Name</strong></td><td>@quiz.CourseName</td><td>@quiz.Category</td><td>@(quiz.Attempts == 0 ? "—" : $"{quiz.PassRate}%")</td><td>@quiz.Attempts</td><td><span class="status @(quiz.Status == "Published" ? "published-status" : "draft-status")">@quiz.Status</span></td></tr> }</tbody></table></section>
