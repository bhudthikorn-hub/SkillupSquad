@model AdminCoursesViewModel
@{ ViewData["Title"] = "Course Management"; Layout = "_AdminLayout"; var search = ViewData["Search"] as string; var category = ViewData["Category"] as string; var categories = ViewData["Categories"] as List<string> ?? []; }
<div class="admin-page-heading"><h1>Course Management</h1><button class="admin-primary-button" type="button" data-open-modal="courseModal" data-modal-title="Add New Course">＋ Add New Course</button></div>
<div class="admin-stat-grid"><div class="admin-stat-card"><span>Total Learners</span><b>@Model.TotalLearners</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></i></div><div class="admin-stat-card"><span>Active Courses</span><b>@Model.ActiveCourses</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></i></div><div class="admin-stat-card"><span>Avg. Completion Rate</span><b>@Model.AverageCompletionRate%</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></i></div><div class="admin-stat-card"><span>Quiz Pass Rate</span><b>@Model.QuizPassRate</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg></i></div></div>
<section class="admin-list-section"><div class="admin-toolbar"><form class="table-search" method="get" onsubmit="return false;"><span>⌕</span><input id="courseSearch" name="search" value="@search" placeholder="Search courses" /><button class="admin-primary-button" type="button" id="courseSearchButton">Search</button></form><select id="courseCategory"><option value="">All categories</option>@foreach (var item in categories) { <option selected="@(item == category)" value="@item">@item</option> }</select></div>
<table class="admin-table"><thead><tr><th>Course</th><th>Category</th><th>Type</th><th>Learners Enrolled</th><th>Status</th><th>Actions</th></tr></thead><tbody id="courseRows">@foreach (var course in Model.Courses) { <tr data-course-row data-admin-result data-admin-kind="course" data-admin-label="@course.Name" data-admin-category="@course.Category" data-admin-url="/Admin/Courses" data-name="@course.Name" data-category="@course.Category"><td><strong><img src="@course.CoverImage" alt="" style="width:42px;height:30px;object-fit:cover;border-radius:6px;vertical-align:middle;margin-right:8px;" />@course.Name</strong></td><td>@course.Category</td><td>@course.Type</td><td>@course.LearnersEnrolled</td><td><span class="status @(course.Status == "Active" ? "active-status" : course.Status == "Draft" ? "draft-status" : "pending-status")">@course.Status</span></td><td class="table-actions"><button type="button" data-edit-course='@System.Text.Json.JsonSerializer.Serialize(course)'>Edit</button><form method="post" asp-action="DeleteCourse" asp-route-id="@course.Id" onsubmit="return confirm('Delete this course?');">@Html.AntiForgeryToken()<button class="delete" type="submit">Delete</button></form></td></tr> }</tbody></table></section>
<div class="admin-modal" id="courseModal" hidden><div class="admin-modal-card"><button class="modal-close" type="button" data-close-modal>×</button><h2 id="courseModalTitle">Add New Course</h2><form method="post" asp-action="SaveCourse"><input type="hidden" name="id" id="courseId" />@Html.AntiForgeryToken()<div class="admin-form-grid"><label>Course name<input required name="name" id="courseName" /></label><label>Category<input required name="category" id="courseCategoryInput" /></label><label>Type<select name="type" id="courseType"><option>Self-paced</option><option>Cohort</option><option>Micro-learning</option></select></label><label>Status<select name="status" id="courseStatus"><option>Active</option><option>Archived</option></select></label></div><div class="modal-actions"><button class="modal-cancel" type="button" data-close-modal>Cancel</button><button class="admin-primary-button" type="submit">Save Course</button></div></form></div></div>
@section Scripts { <script>
const courseModal=document.getElementById('courseModal'); const openCourse=(data)=>{ document.getElementById('courseModalTitle').textContent=data?'Edit Course':'Add New Course'; document.getElementById('courseId').value=data?.Id||''; document.getElementById('courseName').value=data?.Name||''; document.getElementById('courseCategoryInput').value=data?.Category||'3D & Animation'; document.getElementById('courseType').value=data?.Type||'Self-paced'; document.getElementById('courseStatus').value=data?.Status||'Active'; courseModal.hidden=false; }; document.querySelectorAll('[data-open-modal]').forEach(x=>x.onclick=()=>openCourse()); document.querySelectorAll('[data-edit-course]').forEach(x=>x.onclick=()=>openCourse(JSON.parse(x.dataset.editCourse))); document.querySelectorAll('[data-close-modal]').forEach(x=>x.onclick=()=>courseModal.hidden=true); courseModal.onclick=e=>{if(e.target===courseModal)courseModal.hidden=true;};
const filterCourses=()=>{const text=document.getElementById('courseSearch').value.toLowerCase().trim();const category=document.getElementById('courseCategory').value;document.querySelectorAll('[data-course-row]').forEach(row=>{const matchesText=!text||row.dataset.name.toLowerCase().includes(text);const matchesCategory=!category||row.dataset.category===category;row.hidden=!(matchesText&&matchesCategory);});}; document.getElementById('courseSearch').addEventListener('input',filterCourses); document.getElementById('courseCategory').addEventListener('change',filterCourses); document.getElementById('courseSearchButton').addEventListener('click',filterCourses);
</script> }