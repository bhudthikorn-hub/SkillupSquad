@model IReadOnlyList<AdminUserViewModel>
@using System.Globalization
@{ ViewData["Title"] = "User Management"; Layout = "_AdminLayout"; var search = ViewData["Search"] as string; var status = ViewData["Status"] as string; var totalLearners = ViewData["TotalLearners"] is int value ? value : 0; var today = DateTime.Now.Date; var activeThisWeek = Model.Count(user => DateTime.TryParseExact(user.LastActive, "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) && date >= today.AddDays(-6)); var activeToday = Model.Count(user => DateTime.TryParseExact(user.LastActive, "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) && date.Date == today); }
<div class="admin-page-heading"><h1>User Management</h1><button class="admin-primary-button" type="button" id="openUserModal">＋ Add New User</button></div>
<div class="admin-stat-grid"><div class="admin-stat-card"><span>Total Learners</span><b>@Model.Count</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></i></div><div class="admin-stat-card"><span>Active This Week</span><b>@activeThisWeek</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.6 9.6 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg></i></div><div class="admin-stat-card"><span>Avg. Completion Rate</span><b>—</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></i></div><div class="admin-stat-card"><span>Daily Active Users (DAU)</span><b>@activeToday</b><i class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i></div></div>
<section class="admin-list-section"><div class="admin-toolbar"><form class="table-search" method="get"><span>⌕</span><input name="search" value="@search" placeholder="Search name or email" /><button class="admin-primary-button" type="submit">Search</button></form><form method="get"><select name="status" onchange="this.form.submit()"><option value="">All statuses</option><option selected="@(status == "Active")" value="Active">Active</option><option selected="@(status == "Suspended")" value="Suspended">Suspended</option></select></form></div>
<table class="admin-table"><thead><tr><th>Learner Name</th><th>Email Address</th><th>Last Active</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var user in Model) { <tr data-admin-result data-admin-kind="learner" data-admin-label="@user.Name" data-admin-email="@user.Email" data-admin-url="/Admin/Users"><td><strong>@user.Name</strong></td><td>@user.Email</td><td>@user.LastActive</td><td><span class="status @(user.Status == "Active" ? "active-status" : "suspended-status")">@user.Status</span></td><td class="table-actions"><form method="post" asp-action="ToggleStatus" asp-route-id="@user.Id" asp-route-search="@search" asp-route-status="@status">@Html.AntiForgeryToken()<button type="submit">@(user.Status == "Active" ? "Suspend" : "Activate")</button></form><form method="post" asp-action="Delete" asp-route-id="@user.Id" asp-route-search="@search" asp-route-status="@status" onsubmit="return confirm('Delete this user?');">@Html.AntiForgeryToken()<button class="delete" type="submit">Delete</button></form></td></tr> }</tbody></table></section>
<div class="admin-modal" id="userModal" hidden><div class="admin-modal-card"><button class="modal-close" type="button" data-close-user>×</button><h2>Add New User</h2><form method="post" asp-action="AddUser">@Html.AntiForgeryToken()<div class="admin-form-grid"><label>Full name<input required name="name" /></label><label>Email address<input required type="email" name="email" /></label><label>Career goal<input required name="careerGoal" /></label></div><div class="modal-actions"><button class="modal-cancel" type="button" data-close-user>Cancel</button><button class="admin-primary-button" type="submit">Add User</button></div></form></div></div>
@section Scripts { <script>const userModal=document.getElementById('userModal');document.getElementById('openUserModal').onclick=()=>userModal.hidden=false;document.querySelectorAll('[data-close-user]').forEach(x=>x.onclick=()=>userModal.hidden=true);userModal.onclick=e=>{if(e.target===userModal)userModal.hidden=true;};</script> }